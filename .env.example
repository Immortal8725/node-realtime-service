PORT=4001
NODE_ENV=development
JWT_SECRET=replace-with-same-secret-as-spring-backend-min-64-chars-xxxxxxxxxxxx
INTERNAL_API_KEY=replace-with-long-random-internal-key
# Exact origins and optional wildcards (* = one host label, no slash).
# Production example:
# CORS_ORIGINS=https://digimed-connect.co.za,https://www.digimed-connect.co.za,https://*.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://digimed-connect.co.za,https://www.digimed-connect.co.za,https://*.vercel.app
# Railway terminates TLS. Set TRUST_PROXY=false only for a direct local bind.
# TRUST_PROXY=true
JSON_BODY_LIMIT=100kb
# Requests per minute per client IP. OTP send has a tighter cap.
# INTERNAL_RATE_LIMIT_PER_MIN=300
# OTP_SEND_RATE_LIMIT_PER_MIN=30

OTP_DEBUG_MODE=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Optional: Socket.IO multi-instance (Railway Redis). Leave unset for one replica.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_CONNECT_TIMEOUT_MS=10000

# --- Email OTP ---
# auto (default): Resend when both RESEND_* are set, otherwise SMTP, otherwise stub.
# EMAIL_PROVIDER=auto
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=smtp

# Resend (same provider DigiMed clinic email uses). Does not disable SMTP.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="DigiMed Connect <noreply@digimed-connect.co.za>"

# SMTP / nodemailer — still supported
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="DigiMed Connect <noreply@digimed-connect.co.za>"

# --- SMS OTP (Twilio) — preferred phone channel when Spring OTP_PHONE_CHANNEL=sms ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1xxxxxxxxxx
# (TWILIO_FROM without a whatsapp: prefix is also accepted as the SMS sender)

# --- WhatsApp OTP ---
# Pick one provider:

# Baileys (clinic WhatsApp Web / Linked devices — recommended for DigiMed SA clinic line)
# WHATSAPP_PROVIDER=baileys
# BAILEYS_AUTH_DIR=./data/baileys-auth
# BAILEYS_PRINT_QR=true
# Pair: start service → scan QR in console or GET /internal/whatsapp/status (X-Internal-Key)
# Use a single replica + persistent volume for BAILEYS_AUTH_DIR in production.

# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CHANNEL=whatsapp

# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=digimed_otp
# WHATSAPP_TEMPLATE_LANG=en

# Or generic HTTP gateway:
# WHATSAPP_API_URL=https://your-gateway.example/send
# WHATSAPP_API_TOKEN=
