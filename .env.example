PORT=4001
JWT_SECRET=replace-with-same-secret-as-spring-backend-min-64-chars-xxxxxxxxxxxx
INTERNAL_API_KEY=replace-with-long-random-internal-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTP_DEBUG_MODE=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Optional: enable Socket.IO multi-instance fan-out
# REDIS_URL=redis://127.0.0.1:6379

# Optional delivery providers (stubs used when unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@digimed-connect.co.za
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
