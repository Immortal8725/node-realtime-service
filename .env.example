PORT=4001
JWT_SECRET=replace-with-same-secret-as-spring-backend-min-64-chars-xxxxxxxxxxxx
INTERNAL_API_KEY=replace-with-long-random-internal-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTP_DEBUG_MODE=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Optional: Socket.IO multi-instance
# REDIS_URL=redis://127.0.0.1:6379

# --- Email OTP (SMTP / nodemailer) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password-here
# SMTP_FROM="DigiMed Connect <noreply@digimed-connect.co.za>"

# --- WhatsApp OTP ---
# Pick one provider:

# Baileys (clinic WhatsApp Web / Linked devices — recommended for DigiMed SA clinic line)
# WHATSAPP_PROVIDER=baileys
# BAILEYS_AUTH_DIR=./data/baileys-auth
# BAILEYS_PRINT_QR=true
# Pair: start service → scan QR in console or GET /internal/whatsapp/status (X-Internal-Key)
# Use a single replica + persistent volume for BAILEYS_AUTH_DIR in production.

# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CHANNEL=whatsapp

# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=digimed_otp
# WHATSAPP_TEMPLATE_LANG=en

# Or generic HTTP gateway:
# WHATSAPP_API_URL=https://your-gateway.example/send
# WHATSAPP_API_TOKEN=
